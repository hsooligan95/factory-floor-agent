# Optional: leave unset to run fully offline with the built-in
# deterministic composer (no API key needed — this is the demo mode).
# Set these only if you want the optional OpenAI-compatible provider
# to compose answers instead. Its output still has to pass the same
# groundedness check before anything is returned.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
